msgid "New keys"
msgstr "Nouvelles clés"

#: main/src/plugins/omemo/ui/encryption_preferences_entry.vala:100
msgid ""
"New encryption keys from your other devices will be accepted automatically."
msgstr ""
"Les nouvelles clés de chiffrement de vos autres appareils seront acceptées "
"automatiquement."

#: main/src/plugins/omemo/ui/encryption_preferences_entry.vala:160
